# GEMINI_API_KEY: Optional server-side Gemini API key if AI features are enabled.
GEMINI_API_KEY=

# APP_URL: Public URL of the deployed DevStore application (e.g., https://devstore.vercel.app).
APP_URL=http://localhost:3000

# SESSION_SIGNING_SECRET: Secret used to sign demo session tokens, demo state envelopes, and digital download tokens.
# Strongly recommended in Vercel Production Environment Variables for cross-deployment token continuity.
SESSION_SIGNING_SECRET=

# Optional Shared KV / Redis for Demo Mode Persistence across Serverless Instances
# Leave blank to use DevStore's built-in HMAC-signed compressed x-demo-state persistence token.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ==============================================================================
# Payment Gateways & Webhooks (Required for Live Checkouts Only)
# Demo Mode simulates all payment flows without external credentials.
# Register webhooks in provider dashboards AFTER deploying to Vercel:
#   Paystack:    https://<your-vercel-domain>/api/webhooks/paystack
#   Flutterwave: https://<your-vercel-domain>/api/webhooks/flutterwave
# ==============================================================================
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ==============================================================================
# Optional Transactional Email (Resend)
# Leave blank to run DevStore with external email gracefully disabled
# (Templates & dev-only previews remain functional; emails are never faked as sent).
# ==============================================================================
RESEND_API_KEY=
EMAIL_FROM=

# ==============================================================================
# Optional Exchange-Rate API
# Leave blank to use administrator-configurable manual exchange rates.
# ==============================================================================
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=

# ==============================================================================
# Modular Private Digital Storage
# - Local development uses ./private_assets automatically when S3 is unconfigured.
# - Production on Vercel should use a private S3-compatible bucket (AWS S3, Cloudflare R2, etc.)
#   so digital files are never stored publicly or lost on ephemeral serverless containers.
# ==============================================================================
STORAGE_PROVIDER=auto
PRIVATE_STORAGE_DIR=./private_assets
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
